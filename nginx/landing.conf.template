# ======================================================================
# nit out · landing (nitout.com)
#
# Plantilla: la imagen oficial de nginx sustituye ${API_UPSTREAM},
# ${API_ESQUEMA}, ${APP_URL} y ${ROBOTS} al arrancar (docker-compose.yml) y
# deja el resultado en conf.d/. Las variables propias de nginx ($host,
# $remote_addr…) no se tocan: NGINX_ENVSUBST_FILTER sólo deja pasar esas.
#
# Sirve public/ y reenvía a la API SÓLO lo que usa la landing:
#   GET  /api/eventos          el mapa de muestra (anónimo)
#   GET  /api/planes           los precios (cacheado 5 min)
#   GET  /api/imagenes/<id>    las fotos de las pegatinas (cacheadas)
#   POST /api/contacto         el formulario
# Cualquier otra cosa bajo /api/ es 404 aquí: la landing no puede usarse
# como puerta trasera a la app.
# ======================================================================

limit_req_zone  $binary_remote_addr zone=landing_web:10m rate=20r/s;
limit_req_zone  $binary_remote_addr zone=landing_api:10m rate=5r/s;
limit_req_zone  $binary_remote_addr zone=landing_imgreq:10m rate=40r/s;
limit_req_zone  $binary_remote_addr zone=landing_contacto:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=landing_conn:10m;

# Caché de /api/planes y de las fotos. Las fotos son inmutables (cambiar la
# foto crea otra URL), así que cada una llega a la API una vez.
proxy_cache_path /var/cache/nginx/landing levels=1:2 keys_zone=landing_cache:10m max_size=300m inactive=7d use_temp_path=off;

# Escáneres conocidos. Filtro, no defensa: el user-agent se puede falsear.
# Los buscadores y los asistentes que buscan en la web SÍ entran: la landing
# quiere salir en ellos (al revés que la app).
map $http_user_agent $bloqueado {
    default                 0;
    ""                      1;
    "~*(nikto|sqlmap|nmap|masscan|nuclei|wpscan|dirbuster|gobuster|zgrab)"  1;
}

# "all" en producción; "noindex, nofollow" en pruebas.
map $host $robots {
    default "${ROBOTS}";
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    charset utf-8;

    # El TLS lo termina lo de delante (Cloudflare Tunnel o el proxy del
    # homelab): que ninguna redirección salga como http://.
    absolute_redirect off;
    port_in_redirect off;

    # IP real. El contenedor no publica puertos: sólo le llega cloudflared o
    # el proxy del homelab, desde la red de Docker. Se confía en rangos
    # privados y se toma la última IP pública de X-Forwarded-For.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    limit_conn landing_conn 30;
    limit_req_status 429;
    limit_conn_status 429;
    client_max_body_size 8k;   # el formulario no llega a 3 KB

    if ($bloqueado) { return 444; }

    include /etc/nginx/landing/cabeceras.conf;

    # Sondeos típicos: cortar sin responder limpia los logs.
    location ~* ^/(wp-admin|wp-login|wp-content|wp-includes|xmlrpc\.php) { return 444; }
    location ~* ^/(\.env|\.git|\.aws|\.ssh|config\.json|credentials) { return 444; }
    location ~* ^/(phpmyadmin|pma|adminer|cgi-bin|autoload) { return 444; }
    location ~* \.(php|asp|aspx|jsp|cgi|sh|sql|bak|old|swp)$ { return 444; }
    location ~ /\. { return 444; }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml;

    error_page 404 /404.html;

    # ------------------------------------------------------------------
    # API (contenedor api-fiestas en la misma red de Docker)
    # Variable + resolver: nginx vuelve a resolver el host cada 30 s y
    # arranca aunque la API aún no esté levantada.
    # ------------------------------------------------------------------
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;
    set $api_esquema "${API_ESQUEMA}";
    set $api_upstream "${API_UPSTREAM}";

    location = /api/eventos {
        limit_except GET HEAD { deny all; }
        limit_req zone=landing_api burst=20 nodelay;
        include /etc/nginx/landing/proxy-api.conf;
        proxy_set_header Origin "";
        proxy_read_timeout 10s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/landing/cabeceras.conf;
    }

    location = /api/planes {
        limit_except GET HEAD { deny all; }
        limit_req zone=landing_api burst=10 nodelay;
        include /etc/nginx/landing/proxy-api.conf;
        proxy_set_header Origin "";
        proxy_read_timeout 10s;
        proxy_cache landing_cache;
        proxy_cache_key $uri;
        proxy_cache_valid 200 5m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=300" always;
        add_header X-Cache $upstream_cache_status always;
        include /etc/nginx/landing/cabeceras.conf;
    }

    # Comillas por las llaves de la expresión regular.
    location ~ "^/api/imagenes/[A-Za-z0-9_-]{1,80}$" {
        limit_except GET HEAD { deny all; }
        limit_req zone=landing_imgreq burst=100 nodelay;
        include /etc/nginx/landing/proxy-api.conf;
        proxy_set_header Origin "";
        proxy_read_timeout 15s;
        proxy_cache landing_cache;
        proxy_cache_key $uri;
        proxy_cache_valid 200 30d;
        proxy_cache_valid 404 1m;
        proxy_cache_lock on;
        proxy_ignore_headers Vary Set-Cookie;
        add_header X-Cache $upstream_cache_status always;
        include /etc/nginx/landing/cabeceras.conf;
    }

    # El formulario. Aquí sí viaja Origin: la API comprueba que es la landing.
    location = /api/contacto {
        limit_except POST { deny all; }
        limit_req zone=landing_contacto burst=3 nodelay;
        client_max_body_size 8k;
        include /etc/nginx/landing/proxy-api.conf;
        proxy_read_timeout 15s;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/landing/cabeceras.conf;
    }

    location /api/ { return 404; }

    # ------------------------------------------------------------------
    # Estáticos
    # ------------------------------------------------------------------

    # Fuentes y Leaflet no cambian entre despliegues: caché larga.
    location ~ ^/(fonts|vendor)/ {
        limit_except GET HEAD { deny all; }
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        include /etc/nginx/landing/cabeceras.conf;
        access_log off;
    }

    location ~ ^/img/ {
        limit_except GET HEAD { deny all; }
        add_header Cache-Control "public, max-age=86400" always;
        include /etc/nginx/landing/cabeceras.conf;
        access_log off;
    }

    location / {
        limit_req zone=landing_web burst=60 nodelay;
        limit_except GET HEAD { deny all; }
        # La dirección de la app cambia por entorno (APP_URL del .env): en
        # pruebas, los enlaces llevan a kedada.tenebrum.online sin tocar código.
        sub_filter 'https://app.nitout.com' '${APP_URL}';
        sub_filter_once off;
        sub_filter_types application/javascript text/javascript;   # text/html ya va siempre
        # Siempre revalida: un despliegue se ve al momento, sin versionar ficheros.
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/landing/cabeceras.conf;
        try_files $uri $uri/ =404;
    }

    location = /404.html {
        internal;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/landing/cabeceras.conf;
    }

    location = /healthz {
        default_type text/plain;
        access_log off;
        return 200 "ok\n";
    }

    location = /favicon.ico { access_log off; log_not_found off; try_files /icono-192.png =204; }
}
